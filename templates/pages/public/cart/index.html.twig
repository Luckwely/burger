{% extends 'layouts/base.html.twig' %}

{% block body %}
  <main class="pt-16">

    <section class="mx-auto max-w-6xl px-6 py-10 md:py-14 2xl:max-w-7xl" aria-labelledby="cart-heading">
      <h2 id="cart-heading" class="sr-only">Your cart</h2>

      <!-- Empty state -->
      <div id="cart-empty" class="hidden rounded-3xl bg-[#faf6f0] px-6 py-16 text-center">
        <div class="text-6xl" aria-hidden="true">🛒</div>
        <h3 class="mt-4 text-2xl font-semibold">Your cart is empty</h3>
        <p class="mt-2 text-sm text-slate-500">Looks like you haven't added any burgers yet.</p>
        <a href="menu.html" class="mt-6 inline-block rounded-full bg-[#f4511e] px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#d9400f]">Browse the menu</a>
      </div>

      <!-- Cart content -->
      <div id="cart-content" class="hidden grid gap-6 lg:grid-cols-[1fr_380px]">
        <section class="rounded-3xl bg-[#faf6f0] p-6 md:p-8">
          <div class="mb-2 flex items-center justify-between">
            <h3 class="text-xl font-semibold">Your items</h3>
            <button type="button" id="clear-cart" class="text-xs font-semibold text-slate-500 transition hover:text-red-500">Clear cart</button>
          </div>
          <ul id="cart-items" class="divide-y divide-slate-200"></ul>
          <a href="menu.html" class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[#f4511e] hover:underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            Continue shopping
          </a>
        </section>

        <aside class="h-fit rounded-3xl bg-[#faf6f0] p-6 md:p-8 lg:sticky lg:top-24" aria-labelledby="sum-heading">
          <h3 id="sum-heading" class="text-xl font-semibold">Order summary</h3>

          <form id="promo-form" class="mt-5" novalidate>
            <label for="promo" class="mb-2 block text-xs font-medium">Promo code</label>
            <div class="flex gap-2">
              <input id="promo" type="text" placeholder="e.g. BURGER10" class="min-w-0 flex-1 rounded-xl border border-slate-200 bg-white px-3 py-3 text-sm uppercase outline-none transition focus:border-[#f4511e] focus:ring-2 focus:ring-[#f4511e]/20" />
              <button type="submit" class="rounded-full border border-[#f4511e] px-5 py-2 text-xs font-semibold text-[#f4511e] transition hover:bg-[#f4511e] hover:text-white">Apply</button>
            </div>
            <p id="promo-msg" class="mt-2 text-xs" role="status" aria-live="polite"></p>
          </form>

          <dl class="mt-5 space-y-3 border-t border-slate-200 pt-5 text-sm">
            <div class="flex justify-between"><dt class="text-slate-500">Subtotal</dt><dd id="sum-sub" class="font-semibold"></dd></div>
            <div id="sum-disc-row" class="hidden flex justify-between text-green-600"><dt id="sum-disc-label"></dt><dd id="sum-disc" class="font-semibold"></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Delivery fee</dt><dd id="sum-fee" class="font-semibold"></dd></div>
            <div class="flex justify-between"><dt class="text-slate-500">Tax (8%)</dt><dd id="sum-tax" class="font-semibold"></dd></div>
            <div class="flex justify-between border-t border-slate-200 pt-4 text-base"><dt class="font-bold">Total</dt><dd id="sum-total" class="font-bold text-red-500"></dd></div>
          </dl>

          <button type="button" id="checkout" class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#f4511e] px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#d9400f] active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#f4511e]">Login to checkout</button>
          <p id="checkout-msg" class="mt-3 text-sm" role="status" aria-live="polite"></p>
          <p class="mt-3 text-center text-xs text-slate-400">Try codes BURGER10 or WELCOME5</p>
        </aside>
      </div>
    </section>
  </main>
{% endblock %}
