{% extends 'layouts/base.html.twig' %}

{% block body %}
  <main class="pt-16">
    <section
      class="hero-card relative flex min-h-[160px] flex-col justify-end overflow-hidden sm:min-h-[180px] md:min-h-[220px] lg:min-h-[260px] 2xl:min-h-[300px]">
      <img src="{{asset('images/head_bg.jpg')}}" alt="" class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-tr from-orange-500/80 via-orange-600/30 to-transparent"></div>
      <div class="relative mx-auto w-full max-w-6xl px-6 py-7 text-white md:py-8 2xl:max-w-7xl">
        <h2 class="text-2xl font-semibold leading-tight sm:text-3xl 2xl:text-4xl">Our Menu</h2>
        <p class="mt-2 text-sm text-white/90 max-w-xl">The ultimate burger experience, crafted for your couch.</p>
      </div>
    </section>
    <section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20 2xl:max-w-7xl" aria-labelledby="menu-title">
      <div class="flex flex-col gap-6 py-8 lg:flex-row lg:gap-8">

        <!-- Sidebar -->
        <aside class="w-full space-y-4 lg:w-64 lg:shrink-0 xl:w-72">

          <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
            <h3 class="mb-3 text-sm font-semibold">Browse Menu</h3>
            <div class="relative">
              <input id="menu-search" type="search" aria-label="Search the menu" placeholder="Search Here..."
                class="w-full rounded-lg border border-gray-200 py-2 pl-3 pr-9 text-xs outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
              <svg class="absolute right-3 top-2.5 h-4 w-4 text-gray-400" fill="none" stroke="currentColor"
                stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </div>
          </div>

          <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
            <h3 class="mb-3 text-sm font-semibold">All Categories</h3>
            <div id="cat-tabs" class="flex flex-wrap gap-2"></div>
          </div>

          <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
            <h3 class="mb-4 text-sm font-semibold">Price Range</h3>
            <input type="range" min="0" max="5000" value="500" class="w-full" aria-label="Maximum price" />
            <p class="mt-2 text-xs text-gray-500">Up to <span class="font-semibold text-blue-600">$500</span></p>
          </div>

          <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
            <h3 class="mb-3 text-sm font-semibold">Filter by Price</h3>
            <div class="space-y-2 text-xs text-gray-500">
              <label class="flex cursor-pointer items-center gap-2"><input type="checkbox"
                  class="h-3.5 w-3.5 rounded border-gray-300 text-blue-600" />$10.00 - $100.00 (150)</label>
              <label class="flex cursor-pointer items-center gap-2"><input type="checkbox"
                  class="h-3.5 w-3.5 rounded border-gray-300 text-blue-600" />$100.00 - $500.00 (717)</label>
              <label class="flex cursor-pointer items-center gap-2"><input type="checkbox"
                  class="h-3.5 w-3.5 rounded border-gray-300 text-blue-600" />$500.00 - $1,000.00 (688)</label>
              <label class="flex cursor-pointer items-center gap-2"><input type="checkbox"
                  class="h-3.5 w-3.5 rounded border-gray-300 text-blue-600" />$1,000.00 - $5,000.00 (901)</label>
