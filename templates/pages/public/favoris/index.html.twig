{% extends 'layouts/base.html.twig' %}

{% block body %}
  <main class="pt-16">

    <section class="mx-auto max-w-6xl px-6 py-10 md:py-14 2xl:max-w-7xl" aria-labelledby="fav-heading">
      <div id="fav-tools" class="mb-6 hidden flex-wrap items-center justify-between gap-3">
        <h2 id="fav-heading" class="text-2xl font-semibold tracking-tight">Liked items <span id="fav-count" class="ml-1 text-sm font-medium text-slate-400"></span></h2>
        <div class="flex items-center gap-3">
          <button type="button" id="fav-clear" class="text-xs font-semibold text-slate-500 transition hover:text-red-500">Clear all</button>
          <button type="button" id="fav-add-all" class="rounded-full bg-[#f4511e] px-5 py-2.5 text-xs font-semibold text-white shadow-md transition hover:bg-[#d9400f] active:scale-95">Add all to cart</button>
        </div>
      </div>

      <div id="fav-empty" class="hidden rounded-3xl bg-[#faf6f0] px-6 py-16 text-center">
        <div class="text-6xl" aria-hidden="true">🤍</div>
        <h3 class="mt-4 text-2xl font-semibold">No favorites yet</h3>
        <p class="mt-2 text-sm text-slate-500">Tap the heart on any item in the menu to save it here.</p>
        <a href="menu.html" class="mt-6 inline-block rounded-full bg-[#f4511e] px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#d9400f]">Browse the menu</a>
      </div>

      <div id="fav-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
    </section>
  </main>

{% endblock %}
