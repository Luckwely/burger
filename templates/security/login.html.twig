{% extends 'layouts/base_auth.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
  
{#
    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
    See https://symfony.com/doc/current/security/remember_me.html

    <div class="checkbox mb-3">
        <input type="checkbox" name="_remember_me" id="_remember_me">
        <label for="_remember_me">Remember me</label>
    </div>
#}

<main class="flex items-center justify-center">

    <section 
        class="mx-auto max-w-6xl px-6 py-10 md:py-14 2xl:max-w-7xl" aria-labelledby="auth-heading">
      <div class="grid gap-6 md:grid-cols-2">
        <section class="hero-card relative hidden min-h-[460px] flex-col justify-end overflow-hidden rounded-3xl md:flex">
          <img src="{{asset('images/login.jpg')}}" alt="" class="absolute inset-0 h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-tr from-orange-500/80 via-orange-600/30 to-transparent"></div>
          <div class="relative p-8 text-white">
            <h2 class="text-3xl font-semibold leading-tight">Good to see you again!</h2>
            <p class="mt-2 max-w-xs text-sm text-white/90">Log in to reorder your favourites and checkout faster.</p>
          </div>
    </section>

    <section class="rounded-3xl bg-[#faf6f0] p-6 md:p-8">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        {% if app.user %}
            <div class="mb-3">
                You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
            </div>
        {% endif %}
          <h2 id="auth-heading" class="mb-6 text-2xl font-semibold tracking-tight">Login</h2>
            <form method="post" class="space-y-5" >
            <div>
              <label for="email" class="mb-2 block text-xs font-medium">Email</label>
              <div class="relative">
                <svg 
                    class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" width="16" height="16" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    aria-hidden="true"
                >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                </svg>
                <input 
                    type="email" 
                    value="{{ last_username }}" 
                    name="_username" 
                    id="email" 
                    required 
                    placeholder="you@example.com" 
                    autocomplete="email"  
                    class="w-full rounded-xl border border-slate-200 bg-white py-3 pl-10 pr-3 text-sm outline-none transition focus:border-[#f4511e] focus:ring-2 focus:ring-[#f4511e]/20 aria-[invalid=true]:border-red-500"  
                    autofocus 
                />
              </div>
              <p class="err mt-1 hidden text-xs text-red-600" data-for="email"></p>
            </div>

            <div>
              <label for="password" class="mb-2 block text-xs font-medium">Password</label>
              <div class="relative">
                <svg 
                    class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" 
                    width="16" 
                    height="16" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" 
                    stroke-linecap="round" 
                    stroke-linejoin="round" 
                    aria-hidden="true"
                >
                    <rect x="4" y="11" width="16" height="10" rx="2"/>
                    <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                </svg>
                <input 
                    type="password" 
                    name="_password" 
                    id="password" 
                    placeholder="Your password" 
                    autocomplete="current-password" 
                    class="w-full rounded-xl border border-slate-200 bg-white py-3 pl-10 pr-3 text-sm outline-none transition focus:border-[#f4511e] focus:ring-2 focus:ring-[#f4511e]/20 aria-[invalid=true]:border-red-500 pr-16" 
                />
                <input 
                    type="hidden" 
                    name="_csrf_token" 
                    data-controller="csrf-protection" 
                    value="{{ csrf_token('authenticate') }}"
                >
                <button 
                    type="button" 
                    data-toggle-pw="password" 
                    class="absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-[#f4511e]"
                >Show
                </button>
              </div>
              <p class="err mt-1 hidden text-xs text-red-600" data-for="password"></p>
            </div>
            <div class="flex items-center justify-between text-xs">
                <label class="flex items-center gap-2 text-slate-600">
                    <input type="checkbox"  name="_remember_me" id="_remember_me" class="h-4 w-4 accent-[#f4511e]" /> Remember me
                </label>
                <div class="checkbox mb-3">
            </div>
            <a href="#" class="font-semibold text-[#f4511e] hover:underline">Forgot password?</a>
            </div>

            <button 
                type="submit" 
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-[#f4511e] px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-[#d9400f] active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#f4511e]"
            >Log in
            </button>

            <p id="status" class="text-sm" role="status" aria-live="polite"></p>

            </form>
            <p class="mt-6 text-center text-sm text-slate-600">New to BurgerGhar? 
                <a href="{{path('app_register')}}" class="font-semibold text-[#f4511e] hover:underline">Create an account</a>
            </p>
        </section>
      </div>
    </section>
  </main>
  <script>
    document.querySelectorAll("[data-toggle-pw]").forEach((b) => b.addEventListener("click", () => {
      const i = document.getElementById(b.dataset.togglePw);
      const show = i.type === "password"; i.type = show ? "text" : "password";
      b.textContent = show ? "Hide" : "Show";
    }));
  </script>
{% endblock %}
